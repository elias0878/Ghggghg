    color: #B42318;
    padding: 3px 0px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    margin-top: 0;
    position: absolute;
    bottom: 0;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5rem;
    min-height: 29px;
}
.parsley-style-1 .parsley-errors-list.filled, .parsley-errors-list.filled {
    background: url("../images/icons/feedback-icon.svg") no-repeat center;
    background-size: 1rem;
    background-position: center right;
    padding-inline-start: 1.25rem;
}
.form-control.parsley-error, [class *="col-"].parsley-error {
    margin-bottom: 1.5rem !important;
}
.select2-error-container {
