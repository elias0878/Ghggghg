    background: transparent !important;
    outline: 2px solid #161616 !important;
}
.has-float-label .d-flex.date-group select.form-control {
    border-inline-end: 0;
    border-bottom-left-radius: 0;
    border-top-left-radius: 0;
}
.has-float-label .d-flex.date-group input.form-control {
    border-bottom-right-radius: 0;
    border-top-right-radius: 0;
}
/*DGA Calendar*/
.calendars-popup .calendars {
    box-shadow: 0px 24px 48px -12px rgba(16, 24, 40, .18);
    border-radius: 0.5rem;
    overflow: hidden;
    padding-bottom: 1rem;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
}
.calendars td, .calendars .calendars-month th, .calendars .calendars-month td, .calendars-month, .calendars-month thead {
    border: 0 !important;
    background-color: #fff !important;
}
.calendars-nav, .calendars-ctrl {
    background-color: #ffffff !important;
    color: #161616 !important;
}
.calendars a, .calendars-month span {
    color: #161616;
    font-size: 1rem;
    height: 2.5rem;
    width: 2.5rem !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
}
.calendars-month-header select {
    width: auto !important;
    padding: 0 !important;
}

.calendars-month-header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-inline-start: 1rem;
    width: fit-content;
    margin-top: -1.25rem;
    gap: 1rem;
}

.calendars-nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    width: auto !important;
    padding: 0 !important;
    margin-top: 2rem;
    padding-inline-start: 1rem;
    flex-direction: row-reverse;
}

.calendars-nav .calendars-cmd-today {
    display: none !important;
}

.calendars-nav a {
    height: auto;
    padding: 0;
    width: auto;
}
.calendars-month td .calendars-highlight, .calendars-month td .calendars-selected {
    border-radius: 100% !important;
    background: #1b8354 !important;
    border: 0 !important;
    color: #fff !important;
}
.calendars-month td .calendars-today {
    border: 2px solid #1b8354 !important;
    background: #fff !important;
    color: #1b8354 !important;
    font-weight: 700 !important;
    border-radius: 100% !important;
}
.calendars-month span {
    font-size: 0.875rem;
    font-weight: 400;
    color: #424242;
}
.calendars-nav a.calendars-cmd-prev, .calendars-nav a.calendars-cmd-next {
    background: transparent;
    font-family: "hgi-stroke-rounded" !important;
    font-style: normal;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    position: relative;
    color: #161616 !important;
    font-size: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none !important;
}
.calendars-nav a.calendars-cmd-prev::before {
    content: "㭺";
    font-size: 1.25rem;
}
.calendars-nav a.calendars-cmd-next::before {
    content: "㭫";
    font-size: 1.25rem;
}
.calendars .calendars-ctrl a {
    color: #166A45;
    border-radius: 4px;
    padding: 0 1rem;
}
.calendars .calendars-ctrl a:hover {
    color: #104631;
}
.calendars .calendars-ctrl a:focus {
    color: #166A45;
    outline: 2px solid #161616
}
/*digital-stamp*/
.digital-stamp-head {
    display: flex;
    align-items: center;
    gap: 10px;
}
.digital-stamp-text {
    padding: 0;
    margin: 0;
    color: #161616;
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: 20px;
}
.digital-stamp-link {
    color: #166A45;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 20px;
    display: flex;
    align-items: center;
    cursor: pointer;
    gap: 8px;
}
.digital-stamp-link:hover {
    color: #54c08a;
    text-decoration: underline !important;
}
.digital-stamp-link:focus, .digital-stamp-link:focus-visible {
    color: #166A45;
    outline: 2px solid #161616;
    text-decoration: none !important;
}
.digital-stamp-content {
    margin-top: 2.5rem;
}
.ds-content_item {
    display: flex;
    align-items: flex-start;
    gap: 24px;
}
.ds-content_item_icon {
    display: flex;
    width: 36px;
    height: 36px;
    color: #067647;
    padding: 12px;
    justify-content: center;
    align-items: center;
    border-radius: 10rem;
    border: 1px solid #067647;
    box-shadow: 0px 1px 2px 0px rgba(16, 24, 40, 0.05);
}
.ds-content_item_content {
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.ds-content_item_content h2 {
    color: #161616;
    font-size: 18px;
    font-style: normal;
    font-weight: 600 !important;
    line-height: 28px;
    margin: 0;
}
.ds-content_item_content h2 span {
    color: #1B8354;
}
.ds-content_item_content p {
    margin: 0;
    color: #384250;
    font-size: 1rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5rem;
}
.ds-footer_item {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem;
    padding: 0.5rem 1.5rem;
    border-radius: 0.5rem;
    background: #fff;
}
.ds-footer_item_content {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px;
}
.ds-footer_item_content p {
    margin: 0;
    color: #161616;
    text-align: start;
    font-size: 1rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5rem;
}
.ds-footer_item_content .ds-footer_link {
    color: #1B8354;
    font-size: 1rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5rem;
    text-decoration-line: underline !important;
    cursor: pointer;
}
.ds-footer_item_content .ds-footer_link {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.25rem;
}
.ds-footer_item_content .ds-footer_link::after {
    content: "䊔";
    display: inline-block;
    font-family: hgi-stroke-rounded !important;
    font-style: normal;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    position: relative;
}
.ds-footer_item_content .ds-footer_link:hover {
    color: #54c08a;
    text-decoration-line: underline !important;
}
.ds-footer_item_content .ds-footer_link:focus, .ds-footer_item_content .ds-footer_link:focus-visible {
    color: #1B8354;
    text-decoration-line: none !important;
    outline: 2px solid #161616;
}
