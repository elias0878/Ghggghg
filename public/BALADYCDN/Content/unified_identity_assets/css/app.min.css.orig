}
header.site-header .user-login-sso .dropdown-menu {
    padding: 0.5rem;
}
header.site-header .user-login-sso .dropdown-menu.show a::before {
    display: none;
}
.header-left i {
    color: #ffffff !important;
    font-size: 1.25rem !important;
