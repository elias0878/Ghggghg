.numeric-list {
    list-style: decimal;
    padding-inline-start: 2rem;
}
.numeric-list__item {
    counter-increment: li;
    display: list-item;
    padding-right: 1rem;
    position: relative;
    z-index: 1;
}
.numeric-list__item::marker {
    display: list-item;
    content: " " counter(li) " ";
    color: #161616;
    font-size: 1rem;
}
.numeric-list__item::before {
    content: " ";
    width: 2rem;
    height: 2rem;
    border: 2px solid #9DA4AE;
    background-color: #F7FDF9;
    color: #161616;
    position: absolute;
    display: inline-block;
    border-radius: 10rem;
    right: -1.5rem;
    top: 0.75rem;
    z-index: -1;
}
.numeric-list__item::after {
    content: " ";
    width: 0.1rem;
    height: 100%;
    border-right: 1px dashed #D2D6DB;
    position: absolute;
    right: -0.5rem;
    top: 1.75rem;
    z-index: -2;
}
.numeric-list__item:last-child::after {
    content: none;
}
.ul-dash .list-dash {
    list-style-type: none;
    padding-inline-start: 0.5rem;
}
.ul-dash .list-dash::before {
    content: " - ";
    font-weight: bold;
}
