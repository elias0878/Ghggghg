i[class *="ds-"],
i[class *="ds-"] span {
    font-family: ds;
    color: #1b8354;
    speak: never;
    font-size: inherit;
    font-style: normal;
    font-weight: 400;
    font-variant: normal;
    text-transform: none;
    line-height: inherit;
