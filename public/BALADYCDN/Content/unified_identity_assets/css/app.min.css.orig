.accordion-item {
    background-color: #fff;
    position: relative;
}
.accordion-item::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0px;
    right: 0px;
    height: 1px;
    background: linear-gradient(to right, transparent 0 16px, #d2d6db 16px calc(100% - 16px), transparent calc(100% - 16px) 100%);
}
.accordion-item:first-of-type {
    border-top-left-radius: .25rem;
    border-top-right-radius: .25rem;
}
.accordion-header {
    margin-bottom: 0;
}
.accordion-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.875rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #161616;
    text-align: left;
    background-color: #fff;
    border: 0;
    border-radius: 0;
    overflow-anchor: none;
    transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out, border-radius .15s ease;
}
.accordion-item:first-of-type .accordion-button {
    border-top-left-radius: calc(.25rem - 1px);
    border-top-right-radius: calc(.25rem - 1px);
}
.accordion-body {
    padding: 1rem 1.25rem;
}
.accordion-item .accordion-body {
    padding: 0.5rem 3rem 1.5rem 1rem;
}
.modal-header {
    border: 0;
}
.text-primary {
    color: #1b8354 !important;
}
.btn-white {
    border: 1px solid #9DA4AE;
}
.service-row-list .card-body .card .card-body .item-content {
    flex-flow: row;
    flex-wrap: wrap;
}
table tbody td:last-child .btn-sm.btn-dark, .removeDraftRequest, table.table-sm tbody td.table-content:last-child .nav-link {
    background: transparent;
    font-family: "hgi-stroke-rounded" !important;
    font-style: normal;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    position: relative;
    color: #B42318 !important;
    font-size: 1.5rem;
    border-radius: 0.25rem;
    width: 3rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.75rem;
    cursor: pointer;
}
table tbody td:last-child .btn-sm.btn-dark:hover, .removeDraftRequest:hover, table.table-sm tbody td.table-content:last-child .nav-link:hover {
    background: #FEE4E2;
}
table tbody td:last-child .btn-sm.btn-dark:active, .removeDraftRequest:active, table.table-sm tbody td.table-content:last-child .nav-link:active {
    background: #FECDCA;
}
table tbody td:last-child .btn-sm.btn-dark:focus, .removeDraftRequest:focus, table.table-sm tbody td.table-content:last-child .nav-link:focus {
    background: transparent;
    outline: 2px solid #161616;
}
table tbody td:last-child .btn-sm.btn-dark svg.icon-back, .removeDraftRequest svg, table.table-sm tbody td.table-content:last-child .nav-link [class *="fa-trash"] {
    display: none;
}
table tbody td:last-child .btn-sm.btn-dark::before, .removeDraftRequest::before, table.table-sm tbody td.table-content:last-child .nav-link::before {
    content: "㻺";
}
