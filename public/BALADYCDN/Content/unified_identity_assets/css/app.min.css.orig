}
.header-left .dropdown-menu i {
    color: #161616 !important;
}
.header-left .dropdown-menu i.text-danger {
    color: #dc3545 !important;
}
.sticky .header-left a:not(.b-business), .sticky .header-left i {
    color: #161616 !important;
}
.header-left .region-header-left .btn.b-business {
    padding: 0.5rem 0.7rem;
    border: solid 1px #1B8354;
    color:#fff !important;
    border-radius: 0.25rem;
    font-size: 1rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
}
.header-left .region-header-left .btn.b-business::after {
