}
.form-group.has-float-label #rd-error-container .parsley-errors-list, .form-group.has-float-label [id *="rd-error-"] .parsley-errors-list, .form-group.has-float-label [id *="error-"] .parsley-errors-list {
    top: 4.2rem;
}
