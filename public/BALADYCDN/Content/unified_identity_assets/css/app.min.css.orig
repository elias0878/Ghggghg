.cr-number-cont .row {
    gap: 1rem 0;
}
.alert-warning h3.text-warning.border-0.p-0 {
    font-size: 1.125rem;
    margin: 0;
    color: #6d5303 !important;
    margin-inline-end: -1.5rem;
    border-inline-end: 1px solid #fdb022 !important;
