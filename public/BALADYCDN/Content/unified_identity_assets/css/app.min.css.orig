/********* Table Start ************/
table.dataTable.no-footer {
    padding: 0.1rem;
    border-radius: 0.5rem;
    border: 1px solid #d2d6db !important;
    border-collapse: separate;
    width: 99% !important;
}
table.dataTable.no-footer .dropdown-menu {
    box-shadow: 0 0px 1px 0 rgba(12, 13, 30, 0.3);
}
table.dataTable tbody tr:nth-child(even), table tbody tr:nth-child(even) {
    background: #f5f5f6 !important;
}
table.dataTable tbody tr:nth-child(odd) {
    background-color: #ffffff !important;
}
table thead th, #myTable_wrapper table.dataTable th, table.dataTable th {
    position: relative;
    border-bottom: 0 solid #d2d6db !important;
    font-size: 1rem;
    font-weight: 500 !important;
    color: #000;
    padding: 0.5rem;
    background-color: #f3f4f6 !important;
    z-index: 1;
}
table thead th:not(:last-child), #myTable_wrapper table.dataTable thead th:not(:last-child), table.dataTable thead th:not(:last-child) {
    border-left: 1px solid #d2d6db !important;
}
table tbody td, table.dataTable tbody td, table tbody th {
    padding: 0.5rem !important;
    font-size: 1.125rem !important;
    font-weight: 400;
    color: #161616;
    border-bottom: 0 !important;
    background-color: transparent;
    vertical-align: middle;
}
.table-striped tbody tr:nth-of-type(odd) {
    background-color: transparent;
}
table thead th.border-bottom-0 {
    background: #fff !important;
}
table.table-sm thead th, table.table-sm tbody th, table.table-sm tbody td {
    padding: 0.25rem !important;
}
.calendars-month th, .calendars-month td {
    padding: 0 !important;
}
/********* Table End ************/
/********* Main Menu Start ************/
/* mainHeader */
/* Top Header */
.top-header-content {
    background: #F3F4F6;
    border-bottom: 1px solid #D2D6DB;
}
.top-header {
    display: flex;
    background: #F3F4F6;
    height: 2.5rem;
    padding: 0;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
}
.header-date {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 0.5rem;
}
.header-date span {
    color: #384250;
    font-size: 1rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5rem;
}
.top-header-left {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.375rem;
}
.top-header-left .btn {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 2rem;
    max-height: 2rem;
    padding: 0 0.719rem;
    gap: 0.25rem;
    border: 0;
    box-shadow: none;
    border-radius: 0.25rem;
    font-size: 14px;
    font-weight: 600;
    font-family: IMBPlexSansArabic, "Helvetica Neue", "Helvetica", "Arial", sans-serif !important;
}
.top-header-left .btn.show, .top-header-left .btn:hover {
    background: #e5e7eb;
}
.top-header-left .btn.versions_tool span {
    display: none;
}
.top-header-left .btn.versions_tool div#DeafServicePlace {
    cursor: pointer;
    width: auto;
    height: auto;
    position: relative;
    bottom: unset;
    background: transparent;
    padding-bottom: 0;
    border-radius: 0 !important;
    left: unset;
    z-index: 999;
}
.top-header-left .btn.versions_tool #DeafTranslate, .top-header-left .btn.versions_tool #TranslateStop {
    color: #ffffff !important;
    margin: 0 !important;
}
.top-header-left .btn.versions_tool #DeafTranslate img, .top-header-left .btn.versions_tool #TranslateStop img {
    display: none;
}
/*.top-header-left .btn.show span, .top-header-left .btn:hover span, .top-header-left .btn.versions_tool:hover #DeafTranslate {
    text-decoration: underline;
}*/
.top-header-left .dropdown-menu {
    min-width: 9rem;
    border-radius: 0.5rem;
    border: 0;
    box-shadow: 0px 12px 16px -4px rgba(16, 24, 40, 0.08), 0px 4px 6px -2px rgba(16, 24, 40, 0.03);
}
.top-header-left .dropdown-item {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 0.5rem 1rem;
    gap: 1rem;
    border-radius: 0.5rem;
    color: #1F2A37;
    font-size: 0.925rem;
    font-style: normal;
    font-weight: 500;
    line-height: 1.25rem;
    cursor: pointer;
}
.top-header-left .dropdown-item.active, .top-header-left .dropdown-item:active {
    background-color: #f8f9fa;
}
.muneer-trigger-button-box {
    display: none !important;
}
@media (max-width: 576px) {
    .top-header {
        flex-flow: column;
        justify-content: flex-start;
        align-items: flex-start;
        height: auto;
        padding: 0 0.75rem;
        gap: 0.5rem;
    }
    .top-header-left .btn {
        padding: 0 0.25rem;
        gap: 0.125rem;
        font-size: 0.875rem;
    }
    .top-header-left {
        width: 100%;
        justify-content: space-between;
    }
}
/* mainHeader */
.mainHeader {
    position: relative;
    z-index: 99999;
    width: 100%;
    background-color: #ffffff;
    border-top: 1px solid #D2D6DB;
    border-bottom: 1px solid #D2D6DB;
    transition: background-color 0.5s ease;
}
.mainHeader.inverted {
    position: fixed;
}
.mainHeader>.container>.row .columns,
.mainHeader>.container-fluid>.row .columns {
    align-items: center;
}
@media (min-width: 1200px) {
