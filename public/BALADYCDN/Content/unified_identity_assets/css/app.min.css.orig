.c-tooltip {
    position: relative
}
.c-tooltip:before {
    content: attr(data-tooltip);
    position: absolute;
    right: 100%;
    background: #033836;
    white-space: nowrap;
    z-index: 999;
    color: #fff;
    top: 50%;
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    transform: translateY(-50%);
    padding: 2px 5px;
    font-size: 12px;
    border-radius: 4px;
