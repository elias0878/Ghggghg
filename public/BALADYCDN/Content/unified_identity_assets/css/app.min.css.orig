/********* Modal Start ************/
.modal-open .bg-grey.sticky {
    z-index: unset;
}
.modal-open .modal {
    z-index: 10050;
}
.modal-backdrop {
    z-index: 10040;
}
.modal-open .bg-grey {
    z-index: unset;
    margin-top: auto;
}
.modal-open .site-header-cont {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999 !important;
}
.modal-open .site-header-cont .inner-header-login.site-header {
    height: 105px;
    border-bottom: 1px solid #ededed;
}
.modal-open .page-top-fixed {
    padding-top: 7.5rem;
    background: #fff;
    border-bottom: 1px solid #ededed;
    position: -webkit-sticky;
    position: sticky;
    left: 0;
    right: 0;
    top: 0;
    box-shadow: 0px -2px 15px -5px rgba(0, 0, 0, 0.3);
}
.modal-open .page-top-fixed .form-steps-cont-new {
    display: none;
}
.calendars-popup {
    z-index: 10047 !important;
}
.modal-open .calendars-popup {
    z-index: 10051 !important;
}
.swal2-shown .swal2-container {
    z-index: 10050;
}
.swal2-styled.swal2-confirm {
    position: relative;
    z-index: 2;
    font-size: 1rem !important;
    font-weight: 500 !important;
    text-align: center;
    border-radius: 0.25rem !important;
    padding: 0.5rem 0.7rem !important;
    background-color: #1b8354 !important;
    border: solid 1px #1B8354 !important;
    box-shadow: none !important;
    color: #fff !important;
}
.swal2-styled.swal2-cancel {
    position: relative;
    z-index: 2;
    font-size: 1rem !important;
    font-weight: 500 !important;
    text-align: center !important;
    box-shadow: none !important;
    border-radius: 0.25rem !important;
    padding: 0.5rem 0.7rem !important;
    background-color: #fff !important;
    border: 1px solid #D2D6DB !important;
    color: #161616 !important;
}
.swal2-actions {
    display: flex !important;
    align-items: center;
    justify-content: flex-end !important;
    width: 100% !important;
}
.swal2-modal {
    padding: 2rem !important;
}
.swal2-icon {
    display: none !important;
}
.swal2-modal .alert {
    position: relative !important;
    padding: 1rem 3.5rem 1.5rem 1.5rem !important;
    margin-top: 1.75rem !important;
    margin-bottom: 2rem !important;
    border-radius: .5rem;
    font-size: 1.25rem !important;
    text-align: start;
}
.swal2-modal .alert.alert-success {
