/*DGA Attachements*/
.form-control-upload.dga-form-upload.has-float-label > span:last-of-type span {
    font-size: 0.875rem;
    font-weight: 500;
    color: #64748B;
    line-height: 2;
}
.form-control-upload.dga-form-upload.form-group.has-float-label {
    border: 0;
    padding-right: 0;
    padding-left: 0;
    height: auto;
}
.form-control-upload.dga-form-upload .upload-info {
    display: block;
    width: 7.38rem;
    height: 2.5rem !important;
    background-color: #fff !important;
    font-size: 1rem !important;
    text-transform: none;
    color: #161616 !important;
    cursor: pointer !important;
    text-align: center;
    border-radius: 0.25rem;
    border: 1px solid #D2D6DB;
    padding: 0.5rem 1rem;
    line-height: 1.4;
}
.form-control-upload.dga-form-upload input {
    width: 7.38rem;
    height: 2.5rem !important;
    left: auto;
    right: 0;
    top: auto;
    bottom: 0;
    cursor: pointer !important;
}
.form-control-upload.dga-form-upload.uploaded .upload-info {
    width: 100%;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    padding-inline-end: 5rem;
    padding-inline-start: 2rem;
    font-weight: 400;
    text-align: start;
}
body .form-control-upload.dga-form-upload .btn.attachmentview, body .form-control-upload.dga-form-upload .btn.attachmentclear {
    display:none;
}
body .form-control-upload.dga-form-upload.uploaded .btn.attachmentview, body .form-control-upload.dga-form-upload.uploaded .btn.attachmentclear {
    float: left;
    position: absolute;
    z-index: 997;
    top: auto;
    bottom: 4px;
    left: 10px !important;
    margin-top: 0 !important;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.form-control-upload.dga-form-upload.uploaded .upload-info::before, #attachment .form-control-upload.dga-form-upload.uploaded.req .upload-info::before {
    font-family: "hgi-stroke-rounded" !important;
    font-style: normal;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    content: "䤈" !important;
    border-radius: 10rem;
    background: #1b8354 !important;
    color: #fff;
    width: 1.5rem;
    height: 1.5rem;
    display: flex !important;
    align-items: center;
    justify-content: center;
    position: absolute;
    right: 0.25rem !important;
    left: auto !important;
    top: auto;
}
.form-control-upload.dga-form-upload.uploaded .upload-info ~ input {
    width: calc(100% - 5rem);
}
.form-control-upload.dga-form-upload.has-float-label > span:last-of-type {
    font-size: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
}
body .form-control-upload.dga-form-upload .btn.attachmentclear ~ .btn.attachmentview {
    left: 2.75rem !important;
}
/**/
table.dataTable tbody td .dropdown-menu svg {
    display: none;
