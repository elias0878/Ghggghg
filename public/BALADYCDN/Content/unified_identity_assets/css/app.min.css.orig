/*Inspection Radio Button*/
#divSearchOptions .toggle-items-cont {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
}
#divSearchOptions label.radio-inline {
    flex-flow: row;
    justify-content: flex-start;
    border-radius: 0.5rem;
    margin-right: 0 !important;
    padding-right: 0.5rem;
    padding-left: 1rem;
    padding-top: .2885rem;
    padding-bottom: .2885rem;
    border: 0 solid #9DA4AE !important;
    background: #fff !important;
    font-size: 1rem;
    color: #161616 !important;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    align-items: flex-start;
    transition: all 0.2s ease-in-out;
    font-weight: 700;
    cursor: pointer;
    box-shadow: none;
    width: calc(100% / 4 - 1rem);
}
#divSearchOptions input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 20px !important;
    height: 20px !important;
    border: 1px solid #BCC5BC !important;
    border-radius: 50%;
    position: relative;
    cursor: pointer;
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 0.25rem;
    padding: 0;
}
#divSearchOptions input[type="radio"]:checked {
    border-color: #1b8354 !important;
}
#divSearchOptions input[type="radio"]:checked::before {
    content: "";
    width: 12px;
    height: 12px;
    background-color: #1b8354 !important;
    border-radius: 50%;
    position: absolute;
    top: 3px;
    left: 3px;
}
#divSearchOptions label.radio-inline:focus, #divSearchOptions label.radio-inline:active,
#divSearchOptions label.radio-inline:has(input[type="radio"]:checked) {
    border: 2px solid #161616 !important;
    border-radius: 0;
}
@media (max-width: 991.8px) {
    #divSearchOptions label.radio-inline {
        width: calc(100% / 2 - 0.5rem);
    }
}
@media (max-width: 576px) {
    #divSearchOptions label.radio-inline {
        width: 100%;
    }
}
