.row#Buttons [type="button"] {
    width: auto;
    line-height: 1;
}
.row#Buttons {
    float: inline-end;
    margin-top: 1rem;
}
form[action *="/Eservices/health/Inquiries/Search"] .d-flex.align-items-center.justify-content-start {
    padding-right: 15px;
    padding-left: 15px;
    position: relative;
    width: 100%;
    align-items: flex-end !important;
    flex-wrap: wrap;
    gap: 0.5rem;
}
@media (min-width: 768px) {
    form[action *="/Eservices/health/Inquiries/Search"] .d-flex.align-items-center.justify-content-start {
        -webkit-box-flex: 0;
        -webkit-flex: 0 0 50%;
        -ms-flex: 0 0 50%;
        flex: 0 0 50%;
        max-width: 50%;
    }
}
form[action *="/Eservices/health/Inquiries/Search"] .d-flex.align-items-center.justify-content-start .d-flex {
    gap: 0.5rem;
}
form[action *="/Eservices/health/Inquiries/Search"] .d-flex.align-items-center.justify-content-start .d-flex img {
    height: 2.5rem;
    padding: 0 !important;
    object-fit: none;
    margin-bottom: 0.25rem;
}
form[action *="/Eservices/health/Inquiries/Search"] .d-flex.align-items-center.justify-content-start .d-flex .btn {
    height: 2.5rem;
}
