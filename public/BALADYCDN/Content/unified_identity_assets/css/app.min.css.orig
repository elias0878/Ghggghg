.title-heading h1 {
    color: #FFF;
    font-size: 32px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
}
.page-container .section .row {
    align-items: flex-start;
}
.custom-accordion .collapse {
    padding: 1rem;
}
.section .card-body>.heading.mt-5:first-of-type, .section .card-body .heading.mt-md-5:first-of-type {
    margin-top: 0 !important;
}
.section .heading .sub-heading h2::before {
    display: none !important;
    content: "\f01c";
    -webkit-font-smoothing: antialiased;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-style: normal;
    font-variant: normal;
    text-rendering: auto;
    line-height: 1;
    font-family: 'Font Awesome 5 Free';
    font-weight: 900;
    color: #84BC47;
    background: #f2f8ec;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    font-size: 1.5rem;
    margin-inline-end: .5rem;
}
.section .service-row-list .card-body .heading .sub-heading h2::before {
    content: "\f15c";
    border-radius: 8px;
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    color: #1b8354;
    background: #f2f2f2;
}
.section .heading:after {
    display: none;
}
.has-float-label {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    flex-flow: column-reverse;
    position: relative;
}
.has-float-label>span:last-of-type, .has-float-label label {
    position: relative;
    top: 0;
    right: 0;
    margin-bottom: 0.5rem;
    color: #161616;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25rem;
}
@media (max-width: 991.8px) {
    .wizard .has-float-label:not(.form-control-upload) > span:last-of-type, .wizard .has-float-label:not(.form-control-upload) label {
        text-shadow: none !important;
        font-weight: 700 !important;
        font-size: 85% !important;
        top: 0 !important;
        right: 0 !important;
    }
    .blockquote {
        margin-top: 1rem;
    }
}
.has-float-label>span::after, .has-float-label label:not(.custom-control-label)::after {
    display: none;
}
.form-control, input, select, textarea, .form-control-upload {
    width: 100%;
    height: 2.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid #9DA4AE;
    background: #FFF;
}
.form-control[readonly], .form-control[disabled], .form-control:disabled {
    background: #F2F2F2;
    color: #4c515a !important;
    cursor: not-allowed;
}
.form-control-upload {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 2.5rem !important;
}
.form-control-upload.has-float-label>span:last-of-type {
    top: -2.125rem;
}
.custom-accordion .collapse {
    margin-top: 1rem;
}
.form-group.has-float-label {
    margin-bottom: 0.5rem !important;
}
.form-control-upload.form-group.has-float-label {
    margin-bottom: 3rem !important;
}
body .form-control-upload.form-group.has-float-label {
    margin-top: 1.5rem !important;
    margin-bottom: 2.25rem !important;
}
.badge {
    padding: .5em .4em;
    border-radius: 0.5rem;
}
/*DGA Status Badge*/
.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 0.765rem;
    background-color: #f9fafb;
    border: 1px solid #E5E7EB;
    border-radius: .4rem;
    color: #1f2a37;
    font-size: 0.875rem !important;
    font-weight: 600;
    text-align: center
}
.badge-info {
    color: #fff;
    background-color: #3B3A99;
}
.badge-warning {
    color: #332909;
    background: #FFC107;
}
.badge-danger {
    color: #fff;
    background: #AD1221;
}
.badge-primary {
    color: #fff;
    background-color: #0F6542;
}
.badge-success {
    color: #fff;
    background-color: #0F6542;
}
.badge-dark {
    color: #fff;
    background-color: #3D5C5C;
}
/*DGA Status Badges*/
.badge.badge-info {
    background-color: #eff8ff;
    border-color: #b2ddff;
    color: #1849a9
}
.badge.badge-success {
    background-color: #ecfdf3;
    border-color: #abefc6;
    color: #085d3a
}
.badge.badge-primary {
    background-color: #ecfdf3;
    border-color: #abefc6;
    color: #085d3a
}
.badge.badge-warning {
    background-color: #fffaeb;
    border-color: #fedf89;
    color: #93370d
}
.badge.badge-danger {
    background-color: #ffefef;
    border-color: #ffb2b2;
    color: #a91818
}
/* Draft */
.badge.badge-draft.Draft {
    background-color: #f9fafb;
    border-color: #E5E7EB;
    color: #1f2a37;
}
/* Active */
.badge.badge-success.Active {
    background-color: #ECFDF3;
    border-color: #ABEFC6;
    color: #085D3A;
}
/* Expired */
.badge.badge-danger.Expired {
    background-color: #ffefef;
    border-color: #ffb2b2;
    color: #991B1B;
}
/* Cancelled */
.badge.badge-danger.Cancelled {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
    color: #7F1D1D;
}
/* Pending */
.badge.badge-info.Pending {
    background-color: #eff8ff;
    border-color: #b2ddff;
    color: #1849a9;
}
/* Distributor */
.badge.badge-info.Distributor {
    background-color: #EFF6FF;
    border-color: #BFDBFE;
    color: #2563EB;
}
/* Suspended */
.badge.badge-warning.Suspended {
    background-color: #fff3ed;
    border-color: #fed7aa;
    color: #9a3412;
}
/* Fully Sorted */
.badge.badge-primary.Fully {
    background-color: #EEF2FF;
    border-color: #C7D2FE;
    color: #1E40AF;
}
/* Partially Sorted */
.badge.badge-draft.Partially {
    background-color: #F3F4F6;
    border-color: #D1D5DB;
    color: #495361;
}
/* Expiring Soon */
.badge.badge-warning.Expiring-soon {
    background-color: #FFFAEB;
    border-color: #FEDF89;
    color: #93370D;
}
/* Others */
.badge.badge-primary.Others {
    background-color: #EFF6FF;
    border-color: #BFDBFE;
    color: #2563EB;
}
.services-row.cols-2 .card {
    border: 1px solid #d2d6db !important;
    border-radius: 0.5rem !important;
    background-color: #fff;
    margin-bottom: 1rem;
    box-shadow: none;
}
.service-row-list .card-header {
    align-items: flex-start;
}
.service-row-list .card-header .arrow-hover {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: .5rem;
}
.service-row-list .card-header .arrow-hover svg {
    width: 2.4rem;
    height: 2.4rem;
    fill: #161616;
    stroke-width: 2px;
    stroke: #161616;
    -webkit-transition: .25s all;
    transition: .25s all;
    background: #F9FAFB;
    border-radius: 100%;
    padding: .75rem;
}
.service-row-list .card-header[aria-expanded="true"] .arrow-hover svg {
    transform: rotate(180deg);
    background: #1b8354;
    fill: #fff;
    stroke: #fff;
    stroke-width: 3px;
}
.service-row-list .item-content h3 {
    font-size: 1rem !important;
    color: #161616 !important;
    font-weight: 700 !important;
}
.service-row-list .card-body .item-content .item-content-details .title {
    font-size: 1rem;
    font-weight: 400;
    color: #585858;
    margin-bottom: 0.5rem;
}
.service-row-list .card-body .item-content .item-content-details .description {
    font-size: 1rem;
    color: #161616;
    font-weight: 700;
    margin-bottom: 0;
}
.service-row-list .card-body .item-footer {
    padding: .5rem 1rem;
    gap: 0.5rem;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    flex-wrap: wrap;
}
.service-row-list .card-body .item-footer .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
    padding: 0 1rem;
    height: 2.5rem;
    border-radius: 0.25rem;
    margin-bottom: 0;
    background: #1b8354;
    border: 1px solid transparent;
    box-shadow: none;
    font-weight: 700;
    color: #fff;
    margin-top: 0 !important;
}
.service-row-list .card-body .item-footer .btn.btn-white {
    color: #161616;
    background-color: #fff;
    border: 1px solid #D2D6DB;
}
.service-row-list .card-body .item-footer .btn.btn-white:hover {
    background: #F3F4F6;
